{
  "name": "obsidian-openrouter-plugin",
  "version": "1.4.0",
  "private": true,
  "description": "OpenRouter chat for Obsidian",
  "license": "GPL-3.0-only",
  "engines": { "node": ">=24.15.0" },
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": { "markdown-it": "15.0.2" },
  "devDependencies": {
    "@types/node": "26.6.4",
    "esbuild": "0.28.2",
    "jsdom": "30.1.1",
    "obsidian": "1.11.4",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "overrides": { "obsidian": { "moment": "2.31.0" } }
}
